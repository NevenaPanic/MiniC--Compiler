Terminals unused in grammar

    _AROP


Grammar

    0 $accept: program $end

    1 program: global_variable_list function_list

    2 global_variable_list: %empty
    3                     | global_variable_list global_variable

    4 global_variable: _TYPE _ID _SEMICOLON

    5 function_list: function
    6              | function_list function

    7 $@1: %empty

    8 function: _TYPE _ID $@1 _LPAREN parameter _RPAREN body

    9 parameter: %empty
   10          | parameters

   11 parameters: _TYPE _ID
   12           | parameters _COMMA _TYPE _ID

   13 $@2: %empty

   14 body: _LBRACKET variable_list $@2 statement_list _RBRACKET

   15 variable_list: %empty
   16              | variable_list variable

   17 $@3: %empty

   18 variable: _TYPE $@3 vars _SEMICOLON

   19 vars: _ID
   20     | vars _COMMA _ID

   21 statement_list: %empty
   22               | statement_list statement

   23 statement: compound_statement
   24          | assignment_statement
   25          | if_statement
   26          | return_statement
   27          | increment_statement
   28          | for_statement
   29          | branch_statement
   30          | void_function_call
   31          | switch_statement

   32 compound_statement: _LBRACKET statement_list _RBRACKET

   33 assignment_statement: _ID _ASSIGN num_exp _SEMICOLON

   34 $@4: %empty

   35 $@5: %empty

   36 for_statement: _FOR _LPAREN _TYPE _ID _SEMICOLON $@4 rel_exp $@5 _SEMICOLON _ID _INC _RPAREN statement

   37 $@6: %empty

   38 $@7: %empty

   39 $@8: %empty

   40 $@9: %empty

   41 $@10: %empty

   42 $@11: %empty

   43 $@12: %empty

   44 $@13: %empty

   45 branch_statement: _BRANCH _LPAREN _ID _SEMICOLON literal _COMMA literal _COMMA literal _RPAREN $@6 _FIRST $@7 statement $@8 _SECOND $@9 statement $@10 _THIRD $@11 statement $@12 _OTHERWISE $@13 statement _END_BRANCH

   46 $@14: %empty

   47 switch_statement: _SWITCH _LPAREN _ID $@14 _RPAREN _LBRACKET cases default _RBRACKET

   48 $@15: %empty

   49 case: _CASE con_exp $@15 _TWO_DOTS statement break

   50 cases: case
   51      | cases case

   52 break: %empty
   53      | _BREAK _SEMICOLON

   54 default: %empty

   55 $@16: %empty

   56 default: _DEFAULT $@16 _TWO_DOTS statement

   57 conditional_exp: _LPAREN rel_exp _RPAREN _Q_MARK con_exp _TWO_DOTS con_exp

   58 con_exp: literal
   59        | _ID

   60 num_exp: exp

   61 exp: literal
   62    | _ID
   63    | function_call
   64    | _LPAREN num_exp _RPAREN
   65    | increment
   66    | conditional_exp
   67    | exp _ADD exp
   68    | exp _SUB exp
   69    | exp _MUL exp
   70    | exp _DIV exp
   71    | _SUB exp
   72    | exp _POW exp

   73 literal: _INT_NUMBER
   74        | _UINT_NUMBER

   75 increment_statement: increment _SEMICOLON

   76 increment: _ID _INC

   77 $@17: %empty

   78 void_function_call: _ID $@17 _LPAREN argument _RPAREN _SEMICOLON

   79 $@18: %empty

   80 function_call: _ID $@18 _LPAREN argument _RPAREN

   81 argument: %empty
   82         | arguments

   83 arguments: num_exp
   84          | arguments _COMMA num_exp

   85 if_statement: if_part
   86             | if_part _ELSE statement

   87 @19: %empty

   88 $@20: %empty

   89 if_part: _IF _LPAREN @19 rel_exp $@20 _RPAREN statement

   90 rel_exp: num_exp _RELOP num_exp

   91 return_statement: _RETURN _SEMICOLON
   92                 | _RETURN num_exp _SEMICOLON


