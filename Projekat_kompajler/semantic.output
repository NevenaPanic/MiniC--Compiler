Terminals unused in grammar

    _AROP


Grammar

    0 $accept: program $end

    1 program: global_variable_list function_list

    2 global_variable_list: %empty
    3                     | global_variable_list global_variable

    4 global_variable: _TYPE _ID _SEMICOLON

    5 function_list: function
    6              | function_list function

    7 $@1: %empty

    8 function: _TYPE _ID $@1 _LPAREN parameter _RPAREN body

    9 parameter: %empty
   10          | parameters

   11 parameters: _TYPE _ID
   12           | parameters _COMMA _TYPE _ID

   13 $@2: %empty

   14 body: _LBRACKET variable_list $@2 statement_list _RBRACKET

   15 variable_list: %empty
   16              | variable_list variable

   17 $@3: %empty

   18 variable: _TYPE $@3 vars _SEMICOLON

   19 vars: _ID
   20     | vars _COMMA _ID

   21 statement_list: %empty
   22               | statement_list statement

   23 statement: compound_statement
   24          | assignment_statement
   25          | if_statement
   26          | return_statement
   27          | increment_statement
   28          | for_statement
   29          | branch_statement
   30          | void_function_call
   31          | switch_statement
   32          | break_statement

   33 compound_statement: _LBRACKET statement_list _RBRACKET

   34 assignment_statement: _ID _ASSIGN num_exp _SEMICOLON

   35 $@4: %empty

   36 $@5: %empty

   37 for_statement: _FOR _LPAREN _TYPE _ID _SEMICOLON $@4 rel_exp $@5 _SEMICOLON _ID _INC _RPAREN statement

   38 $@6: %empty

   39 $@7: %empty

   40 $@8: %empty

   41 $@9: %empty

   42 $@10: %empty

   43 $@11: %empty

   44 $@12: %empty

   45 $@13: %empty

   46 branch_statement: _BRANCH _LPAREN _ID _SEMICOLON literal _COMMA literal _COMMA literal _RPAREN $@6 _FIRST $@7 statement $@8 _SECOND $@9 statement $@10 _THIRD $@11 statement $@12 _OTHERWISE $@13 statement _END_BRANCH

   47 @14: %empty

   48 $@15: %empty

   49 switch_statement: _SWITCH _LPAREN _ID @14 _RPAREN $@15 _LBRACKET switch_sections _RBRACKET

   50 switch_sections: switch_section
   51                | switch_sections switch_section

   52 switch_section: switch_label switch_items

   53 switch_items: %empty
   54             | switch_items statement

   55 $@16: %empty

   56 switch_label: _CASE literal $@16 _TWO_DOTS

   57 $@17: %empty

   58 switch_label: _DEFAULT $@17 _TWO_DOTS

   59 break_statement: _BREAK _SEMICOLON

   60 conditional_exp: _LPAREN rel_exp _RPAREN _Q_MARK con_exp _TWO_DOTS con_exp

   61 con_exp: literal
   62        | _ID

   63 num_exp: exp

   64 exp: literal
   65    | _ID
   66    | function_call
   67    | _LPAREN num_exp _RPAREN
   68    | increment
   69    | conditional_exp
   70    | exp _ADD exp
   71    | exp _SUB exp
   72    | exp _MUL exp
   73    | exp _DIV exp
   74    | _SUB exp
   75    | exp _POW exp

   76 literal: _INT_NUMBER
   77        | _UINT_NUMBER

   78 increment_statement: increment _SEMICOLON

   79 increment: _ID _INC

   80 $@18: %empty

   81 void_function_call: _ID $@18 _LPAREN argument _RPAREN _SEMICOLON

   82 $@19: %empty

   83 function_call: _ID $@19 _LPAREN argument _RPAREN

   84 argument: %empty
   85         | arguments

   86 arguments: num_exp
   87          | arguments _COMMA num_exp

   88 if_statement: if_part
   89             | if_part _ELSE statement

   90 @20: %empty

   91 $@21: %empty

   92 if_part: _IF _LPAREN @20 rel_exp $@21 _RPAREN statement

   93 rel_exp: num_exp _RELOP num_exp

   94 return_statement: _RETURN _SEMICOLON
   95                 | _RETURN num_exp _SEMICOLON


