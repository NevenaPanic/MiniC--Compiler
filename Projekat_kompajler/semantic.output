Terminals unused in grammar

    _AROP


Grammar

    0 $accept: program $end

    1 program: global_variable_list function_list

    2 global_variable_list: %empty
    3                     | global_variable_list global_variable

    4 global_variable: _TYPE _ID _SEMICOLON

    5 function_list: function
    6              | function_list function

    7 $@1: %empty

    8 function: _TYPE _ID $@1 _LPAREN parameter _RPAREN body

    9 parameter: %empty
   10          | parameters

   11 parameters: _TYPE _ID
   12           | parameters _COMMA _TYPE _ID

   13 $@2: %empty

   14 body: _LBRACKET variable_list $@2 statement_list _RBRACKET

   15 variable_list: %empty
   16              | variable_list variable

   17 $@3: %empty

   18 variable: _TYPE $@3 vars _SEMICOLON

   19 vars: _ID
   20     | vars _COMMA _ID

   21 statement_list: %empty
   22               | statement_list statement

   23 statement: compound_statement
   24          | assignment_statement
   25          | if_statement
   26          | return_statement
   27          | increment_statement
   28          | for_statement
   29          | branch_statement
   30          | void_function_call
   31          | switch_statement
   32          | break_statement

   33 compound_statement: _LBRACKET statement_list _RBRACKET

   34 assignment_statement: _ID _ASSIGN num_exp _SEMICOLON

   35 $@4: %empty

   36 $@5: %empty

   37 for_statement: _FOR _LPAREN _TYPE _ID _SEMICOLON $@4 rel_exp $@5 _SEMICOLON _ID _INC _RPAREN statement

   38 $@6: %empty

   39 $@7: %empty

   40 $@8: %empty

   41 $@9: %empty

   42 $@10: %empty

   43 $@11: %empty

   44 $@12: %empty

   45 $@13: %empty

   46 branch_statement: _BRANCH _LPAREN _ID _SEMICOLON literal _COMMA literal _COMMA literal _RPAREN $@6 _FIRST $@7 statement $@8 _SECOND $@9 statement $@10 _THIRD $@11 statement $@12 _OTHERWISE $@13 statement _END_BRANCH

   47 $@14: %empty

   48 switch_statement: _SWITCH _LPAREN num_exp _RPAREN $@14 _LBRACKET switch_sections _RBRACKET

   49 switch_sections: switch_label switch_items

   50 switch_items: %empty
   51             | switch_items switch_label
   52             | switch_items statement

   53 $@15: %empty

   54 switch_label: _CASE literal $@15 _TWO_DOTS

   55 $@16: %empty

   56 switch_label: _DEFAULT $@16 _TWO_DOTS

   57 break_statement: _BREAK _SEMICOLON

   58 conditional_exp: _LPAREN rel_exp _RPAREN _Q_MARK con_exp _TWO_DOTS con_exp

   59 con_exp: literal
   60        | _ID

   61 num_exp: exp

   62 exp: literal
   63    | _ID
   64    | function_call
   65    | _LPAREN num_exp _RPAREN
   66    | increment
   67    | conditional_exp
   68    | exp _ADD exp
   69    | exp _SUB exp
   70    | exp _MUL exp
   71    | exp _DIV exp
   72    | _SUB exp
   73    | exp _POW exp

   74 literal: _INT_NUMBER
   75        | _UINT_NUMBER

   76 increment_statement: increment _SEMICOLON

   77 increment: _ID _INC

   78 $@17: %empty

   79 void_function_call: _ID $@17 _LPAREN argument _RPAREN _SEMICOLON

   80 $@18: %empty

   81 function_call: _ID $@18 _LPAREN argument _RPAREN

   82 argument: %empty
   83         | arguments

   84 arguments: num_exp
   85          | arguments _COMMA num_exp

   86 if_statement: if_part
   87             | if_part _ELSE statement

   88 @19: %empty

   89 $@20: %empty

   90 if_part: _IF _LPAREN @19 rel_exp $@20 _RPAREN statement

   91 rel_exp: num_exp _RELOP num_exp

   92 return_statement: _RETURN _SEMICOLON
   93                 | _RETURN num_exp _SEMICOLON


